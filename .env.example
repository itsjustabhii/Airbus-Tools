# Root environment variables
# Copy this file to .env and fill in the values

NODE_ENV=development
LOG_LEVEL=info

# ── Required secrets (must be set before running docker-compose) ──────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-at-least-32-chars!!
COOKIE_SECRET=change-me-cookie-secret-at-least-32ch!!
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_EXPIRY=15m

# ── Payment ───────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock

# ── AWS / S3 (optional for local dev) ────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=airbus-tools-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=        # set for LocalStack: http://localhost:4566
# AWS_SES_ENDPOINT=       # set for LocalStack: http://localhost:4566

# ── Email ─────────────────────────────────────────────────────────────────────
SES_FROM_ADDRESS=noreply@airbus-tools.example.com

# ── Web build args (baked into the Vite bundle) ───────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME=Airbus-Tools
